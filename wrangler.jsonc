// Konfiguracja Cloudflare Workers: pliki aplikacji + bramka z kodami.
// Hasła (SEKRET, ADMIN_HASLO) ustawia się w panelu Cloudflare jako „Secret” – nie wpisuj ich tutaj.
{
  "name": "nauka-sw",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "KODY" }
  ],
  "observability": { "enabled": true }
}
